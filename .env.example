# LLM Provider Configuration
# Supported providers: "openai", "gemini", "mock" (offline fallback)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini

# API Keys (leave empty or set if using live APIs)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Retrieval & Vector Database Configuration
VECTOR_STORE_PATH=data/processed/retrieval_index.pkl
TOP_K_RETRIEVAL=3
SIMILARITY_THRESHOLD=0.65

# Escalation Confidence Thresholds
INTENT_CONFIDENCE_THRESHOLD=0.75
RETRIEVAL_CONFIDENCE_THRESHOLD=0.60
UNSAFE_DECISION_FALLBACK=ESCALATE

# Logging
LOG_LEVEL=INFO
